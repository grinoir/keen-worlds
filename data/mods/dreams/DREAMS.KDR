# Keen Dreams as a Keen Worlds world: the dream Keen has in the Megarocket's
# bed. Written by tools/kw_dreams_port.py from the game's GPL source; the
# data files beside it are converted from the player's copy of the game by
# tools/kw_dreams.py. It runs on the engine's Keen 4 code - its descendant -
# so Keen 4's variables are the base.

%string ca_mapFile "GAMEMAPS.KDR"
%string ca_mapHead "MAPHEAD.KDR"
%string ca_tileInfo "TILEINFO.KDR" # none: the tile properties are in MAPHEAD.KDR
%string ca_gfxInfoFile "GFXINFOE.KDR"
%string ca_graphDict "EGADICT.KDR"
%string ca_graphHead "EGAHEAD.KDR"
%string ca_graphFile "EGAGRAPH.KDR"
%string ca_audioInfoFile "AUDINFOE.KDR"
%string ca_audioDict "AUDIODCT.KDR"
%string ca_audioFile "AUDIO.KDR"
%string ca_audioHead "AUDIOHHD.KDR"

# The score box: its digits are small tiles 1-10 after a blank one
%int ck_scoreBoxBlankTile 0
%int ck_scoreBoxDigitOffset 47
%int ck_scoreBoxScoreColumn 2
%int ck_scoreBoxLivesDigits 1
%int ck_scoreBoxScoreDigits 6
%int ck_scoreBoxShotsColumn 6
%int ck_scoreBoxLivesColumn 2

