# Keen 8: Dead in the Desert (Ceilick, patching by Levellass, 2009) as a
# Keen Worlds world. A Keen 6 v1.4 mod: its own levels, graphics, tile
# properties and sound, plus the conversion of its CKPatch file (PAT.PAT) to
# Omnispeak variables. The mod's files are the player's copy;
# EGADICT/GFXINFOE/AUDINFOE are Keen 6 v1.4's, from Omnispeak's data.

%string ca_audioHead "AUDIOHED.CK6" # the mod's (uncompressed-name) audio header
%string ca_mapFile "editmaps.ck6"
%string ca_mapHead "maphead.ck6"
%string ca_tileInfo "Keen6.tli"

# Texts (from PAT.PAT's text patches)
# -------------------------------------

%stringarray ck_str_levelNames
	"Calidune",
