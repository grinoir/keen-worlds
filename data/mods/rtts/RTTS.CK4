%string ck_str_storyText
	"Return to the Shadowlands\n\nWhile working in his\nclubhouse Billy hears\na loud noise from the\nyard and decides to\ninvestigate.\n\nSomeone has kidnapped\nhis pet Yorp, Spot!\n\nRushing to Gnosticus IV\nKeen hopes to use\nthe Oracle to find\nout who took his\nbeloved pet.\n\nBut the Oracle Council\nseems to have other\nplans for our hero...\n"
%stringarray ck_str_levelNames
	"Far Shadowlands",
	"Dunesville",
	"Glacier Gate",
	"The Ruins of Sand Yego",
	"Backwoods Blockade",
	"Frigid Fortress",
	"Frozone",
	"Bounder Town",
	"Reflectalus",
	"Lost Longhouse",
	"Pyramid of Fear",
	"Pyramid of Footsteps",
	"Whispering Woods",
	"Pyramid of the Sun",
	"Isle of the Ancients",
	"Isle of Caves",
	"Isle of Ice",
	"Sunken Sinkhole",
	"Jungri-la",
	"",
	"The Bean-with-Bacon\nMegarocket"
%stringarray ck_str_levelEntryText
	"Keen returns to the\nShadowlands",
	"Keen treads into\nDunesville",
	"Keen skates into\nGlacier Gate",
	"Keen may\nbe the cause of\nThe Ruins of Sand Yego",
	"Keen assaults the\nBackwoods Blockade",
	"Keen invades\nthe Frigid Fortress",
	"Keen chills out\nin the Frozone",
	"Keen bounces into\nBounder Town",
	"Keen sees visions\nin Reflectalus",
	"Keen discovers\nthe Lost Longhouse",
	"Keen creeps into the\nPyramid of Fear",
	"Keen is followed\ninto the\nPyramid of Footsteps",
	"Keen is enchanted by\nthe Whispering Woods",
	"Keen gazes into the\nPyramid of the Sun",
	"Keen irreverntly tours\nthe Isle of Ancients",
	"Keen descends\nthe Isle of Caves",
	"Keen slips into\nthe Isle of Ice",
	"Keen plops into\nthe Sunken Sinkhole",
	"Keen basks in\nJungri-la",
	"",
	"Keen launches into the\nBean-with-Bacon\nMegarocket"

%int CK4_LindseyMessage1Level 12
%int CK4_JanitorLevel -1
%int CK4_JanitorPic 87
%string ck4_str_lindsaySays ""
%string ck4_str_lindsayMessage1 "Commander Keen!\nI'm afraid I went\nlooking for the scouts\nand got into a bit of\na pinch. Thank you\nfor rescuing me!"
%string ck4_str_lindsayMessage2 "The Oracle Janitor has\ngone to find the scouts.\nThere's trouble afoot!"
%string ck4_str_lindsayThanks1 "Any time, your highness!\nNow, let's find the rest\nof those scouts!"
%string ck4_str_lindsayThanks2 "Don't worry, princess,\nI'll find them!"
%string ck4_str_janitor1 "I've searched for those\ndarn scouts for days!\nFinally someone has come\nto MY rescue!"
%string ck4_str_janitor2 "I'll leave the rest\nto you, Captain, I'm\ngoing on vacation!"
%string ck4_str_janitor3 "Now wait a minute,\nyou mean I have to\nclean up YOUR mess\nby myself?"
%string ck4_str_janitor4 "Here's my mop."
%string ck4_str_cantSwim "I don't have\nmy wetsuit!"
%string ck4_str_gotWetsuit "I wonder who leaves\nall these wetsuits\nlying around?"
%stringarray rtts_str_scout
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Captain Keen!\nRemember me?\nIt's an honor to be\nsaved by you!",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Oh Comrade Keen! Can I\nhave your autograph?",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"You don't happen to\nhave any snacks with\nyou, do you, Captain?",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Help! I'm afraid\nof the dark!",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Did you see it, Captain?\nIt was THIS big!\nAlmost took my hand off!",
	"Aw schucks, I was\nhoping to be rescued\nby the princess!",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Oh my, Corporal Keen,\nI'm unworthy!",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands.",
	"Commodore Keen!\nI'm so excited I don't\nknow what to do\nwith my hands."
%stringarray rtts_str_keenScout
	"It's Comman-\noh forget it!",
	"It's Comman-\noh forget it!",
	"It's Comman-\noh forget it!",
	"You again?\nTry to stay\nout of trouble.",
	"It's Comman-\noh forget it!",
	"You're even more\nobnoxious than\nthe last one...",
	"It's Comman-\noh forget it!",
	"It's Comman-\noh forget it!",
	"Meet the others\nback at the Megarocket\nfor some candy.",
	"It's Comman-\noh forget it!",
	"How did you get\nall the way down\nhere anyway!?",
	"It's Comman-\noh forget it!",
	"It's Comman-\noh forget it!",
	"You should be more\ncareful, kid.",
	"I could just\nleave you here...",
	"It's Comman-\noh forget it!",
	"I can't disagree\nwith that!",
	"It's Comman-\noh forget it!",
	"It's Comman-\noh forget it!",
	"It's Comman-\noh forget it!",
	"It's Comman-\noh forget it!"

