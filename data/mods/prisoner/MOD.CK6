# The Prisoner's Dilemma, as Keen (Levellass and the community, 2021, v1.0) as a Keen Worlds world.
# Written by kwtools/kw_prisoner.py from the mod's CKPatch file; the data
# files beside it are the player's copy of the mod. It runs on Keen 6.

%string ca_tileInfo "TILEINFO.CK6"

%stringarray ck_str_levelNames
	"A-Danac 2 & 3  ",
	"Cell Block Alpha",
	"Cell Block Beta",
	"Vertical Village",
	"Rusty's Swamp",
	"Old Rail Yard",
	"The Impound Lot",
	"The Greenhouse ",
	"W. Tundra Town",
	"E. Tundra Town",
	"A-Danac Express",
	"Tiny Town",
	"Checkpoint Zero",
	"The Courthouse",
	"The Courthouse",
	"Bloog Control Center",
	"A Cliff?",
	"The Rendezvous Point",
	"High Scores"

%stringarray ck_str_levelEntryText
	"Keen traverses \nA-Danac 2 and 3",
	"Keen sneaks out of \nCell Block Alpha   ",
	"Keen skulks around \nCell Block Beta    ",
	"Keen climbs into   \nVertical Village   ",
	"Keen wades across  \nRusty's Swamp      ",
	"Keen encounters an \nAbandoned Rail Yard",
	"Keen seeks treasure\nat the Impound Lot ",
	"Keen digs\nThe Greenhouse",
	"Keen chills out in \nWest Tundra Town   ",
	"Keen takes the air \nin East Tundra Town",
	"Keen boards the    \nA-Danac Express    ",
	"Keen begins to suspect\nthat teleporter  \nmay have been broken  ",
	"Keen crashes through\nCheckpoint Zero     ",
	"Keen causes disorder\nin the Courthouse   ",
	"Keen demands answers\nin the Courthouse   \n                    ",
	"Keen bravely enters the\nBloog Control Center,\nlooking for Molly",
	"Keen encounters a\nCliff Of Some Sort",
	"Keen meets Rick at\nthe Rendezvous Point",
	"Keen is in the High\nScore screen. Call Id!"

%intarray CK_LevelMusic 0, 1, 1, 4, 4, 3, 2, 5, 5, 5, 3, 6, 2, 7, 7, 6, 8, 8, -1, 0

%string ck6_str_cliffNoRope "Scram! This area is\nfor uniformed\npersonnel only!    "
%string ck6_str_getPasscard "I know I said I was\nvegetarian, but it\ndoesn't count if the\nanimal isn't from\nEarth!"
%string ck6_str_getRope "A cop's uniform! I'm\nsure this'll come\nin handy."
%string ck6_str_getSandwich "Hello, old friend!"
%string ck6_str_grabbiterFed "The Chief Magistrate\nis probably in one of\nthese buildings.\nI'll check here,\nyou check there."
%string ck_str_exitToMap "Exit to A-Danac"
%string ck_str_statusCentilives "COINS"
%stringarray ck_defaultHighScoreNames
	"Id Software - '91",
	"",
	"Jason Blochowiak",
	"Adrian Carmack",
	"John Carmack",
	"Tom Hall",
	"John Romero",
	""

# The mod's changes to the program's rules, as settings
%string ca_audioHead "AUDIOHED.CK6"
# the Chronicle scroll (the game's HELPTEXT story, cut to a scroll)
%string ck_str_storyText "Above Meurglys III,\nbounty hunter Commander\nKeen and his former\nquarry, Rick Uller,\nshake hands: together\nthey will stop Mortimer\nMcMire once and for\nall. But the Union man\nwho comes to arrest\nthem is Mort himself,\nin disguise. He gloats\nof his latest machine,\nthe Re-Synapsizer,\nwhich will triple every\ncreature's wits and\nkill most of them, then\ndrops the pair down a\ncriminal deposit slot\nonto the Twin Prison\nPlanets, A-Danac 2 and\n3. Stripped of their\nships and Keen's pogo,\nlocked in adjoining\ncells, they have one\nhope: break out, reach\nthe Chief Magistrate,\nand play Rick's secret\nrecording of Mort's\nconfession. Now are you\nglad we teamed up?"
# Bobbas (here, caged aliens) do not shoot
%int CK6_BobbaNoShoot 1
# Babobbas (big caged aliens) do not nap or shoot
%int CK6_BabobbaNapChance 0
%int CK6_BabobbaHopsPerShot 0
# go-platforms have no accessory animation
%int CK6_GoPlatNoAccessory 1
# the hero has no pogo until it is found (the "Hello, old friend!" pickup)
%int CK_PogoNeedsWetsuit 1
# the rocket (A-Danac Express) flies without the passcard
%int CK6_RocketNoPasscard 1
# the rendezvous banter (Keen 6's Grabbiter and cliff messages, rewritten)
%string ck6_str_grabbiterHungry "Where were you?!\nAnyway, I'll look\nfor the magistrate\nhere, you go over\nthere."
%string ck6_str_grabbiterFed "The Chief Magistrate\nis probably in one of\nthese buildings.\nI'll check here,\nyou check there."
%string ck6_str_cliffNoRope "Scram! This area is\nfor uniformed\npersonnel only!    "

%override "EPISODE.CK6"

