# Send in the Clorts (a Keen 5 v1.4 mod) as a Keen Worlds world.
# Written by kwtools/kw_clorts.py from the mod's CKPatch file; the data
# files beside it are the player's copy of the mod. It runs on Keen 5.

%string ca_tileInfo "KEEN5.TLI"

%stringarray ck_str_levelNames
	"Aleph Zilch",
	"Zilch Gulch",
	"Baobab Forest",
	"Cave of Acute\nDiscomfort",
	"Spent Fuel Depot",
	"Geothermal Energy\nPlant",
	"Church of\nMortimer McMire",
	"Mort's Library",
	"The Shipyard",
	"The Haunted\nRuins",
	"The Re-Synapsizer",
	"The Cloning Lab",
	"Clortopolis",
	"Bethesda HQ",
	"INDEMNITY!",
	"High Scores"

%stringarray ck_str_levelEntryText
	"Keen zigs and zags\nacross Aleph Zilch",
	"Keen apprehensively\nenters Zilch Gulch",
	"Keen bobs and weaves\ninto Baobab Forest",
	"Keen rappels into\nthe Cave of Acute\nDiscomfort",
	"Keen suits up and\nenters the Spent\nFuel Depot",
	"Keen feverishly\nenters Geothermal\nEnergy Plant",
	"Keen devoutly enters\nChurch of\nMortimer McMire",
	"Keen reads the\nsituation in\nMort's Library",
	"Keen sails into\nThe Shipyard",
	"Keen morbidly enters\nthe Haunted Ruins",
	"This is it!\nKeen enters the\nRe-Synapsizer",
	"Keen dons his lab\ncoat, and enters\nCloning Lab",
	"Keen pounds the\npavement in\nClortopolis",
	"Keen gets meta\nat Bethesda Games\nHeadquarters",
	"Live from Aleph Zilch,\nit's the galaxy's\nfavourite game show:\nINDEMNITY!",
	"Keen unexplainedly\nfind himself by\ntheHigh Scores"

%intarray CK_LevelMusic 0, 1, 1, 2, 3, 2, 4, 5, 3, 5, 7, 6, 6, 8, 9, 4, 6, 1, 0, 10

%string ck5_str_fuseDestroyed "Cool! I wonder what\nthis cloaking device\nwas hiding."
%string ck_str_exitToMap "Exit to AlephZilch"
%string ck_str_statusCentilives "BROCC. "
%stringarray ck_defaultHighScoreNames
	"Id Software - '91",
	"",
	"Jason Blochowiak",
	"Adrian Carmack",
	"John Carmack",
	"Tom Hall",
	"John Romero",
	""

# The mod's changes to the program's rules, as settings
# its own sound and music (20 songs from chunk 186)
%string ca_audioHead "AUDIOHED.CK5"
%string ca_audioDict "AUDIODCT.CK5"
%int ca_audStartMusic 186
%int ca_audNumSongs 20
# the game ends when the fuse on level 10 (Clortopolis) is destroyed, not Keen 5's level 12
%int CK5_QEDLevel 10
# switches lay down thicker bridges
%int CK_BridgeThickness 6
# the Shikadi takes two shots to kill
%int CK5_ShikadiHealth 2
# Spherefuls scatter no particles
%int CK5_SpherefulDiamonds 0
# Sparkies ignore the stunner (the mod: killed only by each other)
%int CK5_SparkyShotProof 1

%override "EPISODE.CK5"

