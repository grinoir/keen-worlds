# Operation Ocflore (Bubbatom, 2020, v1.3) as a Keen Worlds world.
# Written by kwtools/kw_ocflore.py from the mod's CKPatch file; the data
# files beside it are the player's copy of the mod. It runs on Keen 4.

%string ca_tileInfo "KEEN4.TLI"

%stringarray ck_str_levelNames
	"Ocflore V",
	"Ocflore Airport",
	"Imber Inlet",
	"The Enkri Borough",
	"Jungle Crags",
	"Frigid Quarry",
	"Enkri Sanctuary",
	"Pelagic Pillars",
	"Ostrum Absorbor",
	"Mount Amnis",
	"Dorsal Obelisk",
	"Ancient Observatory",
	"The Enkri Shanty",
	"Savanak Temple",
	"The Dorsal Battleship",
	"Swallowed Spire",
	"Evergreen Gate",
	"Sunken Sanctum",
	"The Thicket Steeple"

%stringarray ck_str_levelEntryText
	"Keen navigates\nplanet Ocflore",
	"Keen splashes down at\nthe Ocflore Airport",
	"Keen paddles to the\nImber Inlet",
	"Keen cuts through\nthe Enkri Borough",
	"Keen plunges down\nthe Jungle Crags",
	"Keen cascades into\nthe Frigid Quarry",
	"Keen beholds the\nEnkri Sanctuary",
	"Keen dangles on\nPelagic Pillars",
	"Keen burrows his way to\nthe Ostrum Absorbor",
	"Keen conquers\nMount Amnis",
	"Keen filters through \nthe Dorsal Obelisk",
	"Keen reveals\nthe Ancient Observatory",
	"Keen cracks into \nthe Enkri Shanty",
	"Keen delves into \nthe Savanak Temple",
	"Keen teleports aboard\nthe Dorsal Battleship",
	"Keen subsides into \nthe Swallowed Spire",
	"Keen passes through\nthe Evergreen Gate",
	"Keen plunges into \nthe Sunken Sanctum",
	"Keen catapults up \nthe Thicket Steeple"

%intarray CK_LevelMusic 8, 6, 3, 5, 7, 9, 9, 1, 6, 9, 11, 2, 0, 10, 7, 5, 11, 3, 0, 4

%string ck4_str_councilThanks "Keen comes across an\nartifact the old\n Dorsal spoke of. \n An eleborate \n   relic.   "
%string ck4_str_gotWetsuit "  This is mine now! \n  Let's swim!   "
%string ck4_str_lindsayMessage1 " It's dangerous to  \nstumble in teleporters \n  at the Swallowed   \n Spire. \n"
%string ck4_str_lindsayMessage2 " Keep an eye out for a\n  purple key hidden  \ninside a coral wall.\n      \n"
%string ck4_str_lindsaySays "   The Dorsal says:   \n"
%string ck4_str_lindsayThanks1 "   Don't you worry!   "
%string ck4_str_lindsayThanks2 "Alright, I'll \n     keep my eyes peeled! \n"
%string ck4_str_statusRescued "RELICS"
%string ck4_str_statusWetsuit ""
%string ck_str_exitToMap "  Exit to Ocflore  "
%string ck_str_statusCentilives "OSTRUM"
%stringarray ck4_str_councilMessage
	"Such an intricate bit\n of gear! ",
	"I wonder how these \nthings work.",
	" What now?  ",
	"Great.  You known, you\nlook a lot like the\nlast guy I rescued...",
	"Good idea, Gramps.",
	"May the road rise\nto meet your feet,\nMr. Member.",
	"Wise plan of action,\nyour ancientness.",
	"You're the last one,\nfella. Let's both\nget back to the\nOracle chamber!"
%stringarray ck_defaultHighScoreNames
	"Bubbatom         ",
	"                 ",
	"55Aavenue        ",
	"Kohntarkosz      ",
	"Levellass        ",
	"lemm             ",
	"K1n9_Duk3        ",
	"Id Software - '91"

# The mod's changes to the program's rules, as settings
# its own sound and music: 12 songs
%string ca_audioHead "AUDIOHED.CK4"
%string ca_audioDict "AUDIODCT.CK4"
%int ca_audStartMusic 150
%int ca_audNumSongs 12
# three relics (council members) win the game
%int CK4_NumCouncilsToRescue 3
# music: none for the story, the ending plays level 13's, level 19's while the Ancient talks
%int CK_StarWarsMusicLevel 0
%int CK_EndingMusicLevel 13
%int CK4_CouncilTalkMusicLevel 19
# the relics' box in the status window
%int CK4_StatusCouncilBoxX 95
%int CK4_StatusCouncilBoxW 32
%int CK4_StatusCouncilX 96
# levels 18 and up are its ship levels
%int ck_maxDoneLevel 17
# the foot: where it flies, chosen by level 14 being done
%int CK4_FootByLevelDone 14
%int CK4_FootThereX 0x3300
%int CK4_FootThereY 0x5000
%int CK4_FootBackX 0x3000
%int CK4_FootBackY 0x1700
# the underwater level ends at its left or right side
%int CK4_UnderwaterExitsAtSides 1
# the swimming Keen clips normally
%int CK4_SwimKeenClipNormal 1
# bridges four tiles thick
%int CK_BridgeThickness 4
# the schoolfish's hitbox for walls
%int CK4_SchoolfishClipX 0x180
%int CK4_SchoolfishClipY 0x100
# clouds move faster
%int CK4_CloudXAccel 20
# the Dopefish seeks Keen upside down
%int CK4_DopefishSeekReversed 1
# the Mad Mushroom's hops
%int CK4_MushroomNumJumps 2
%int CK4_MushroomHopYVel -0x18
%int CK4_MushroomJumpYVel -0x4A
# the bounder's jump
%int CK4_BounderBounceYVelocity -0x28
# the bounder's ride
%int CK4_BounderRideXVel 16
# bounders chase Keen
%int CK4_BounderFollowsKeen 1
# the Sprite's shot starts on its second frame
%int CK4_SpriteShotSkipFirst 1
# skypests never land; they slide along the ground
%int CK4_SkypestNeverLands 1
# the Mimrock's attack jump
%int CK4_MimrockJumpYVelocity -0x20
# flying birds never land
%int CK4_BirdNeverLands 1
# the walking bird stands on the ground
%int CK4_BirdSpawnYOffset 0xE1
# the flying bird's acceleration
%int CK4_BirdFlyXAccel 32
# markers 36-38: flying birds on easy, normal, hard
%int OC_FlyingBirdMarkers 1
# which creatures Keen is drawn in front of
%int CK4_LickZLayer 0
%int CK4_MimrockZLayer 0
%int CK4_InchwormZLayer 0
%int CK4_SmirkyZLayer 1
%int CK4_SlugZLayer 0
%int CK4_EggZLayer 1
# where the stun stars are
%int CK4_SkypestStarsX 0x40
%int CK4_SkypestStarsY -0x80
%int CK4_LickStarsX 0x40
%int CK4_LickStarsY -0x15E
%int CK4_SlugStarsX -0x80
%int CK4_SlugStarsY -0x80
%int CK4_InchwormStarsX -0x80
%int CK4_BounderStarsX 0xC0
%int CK4_BounderStarsY -0x80
%int CK4_SmirkyStarsX 0xC0
%int CK4_SmirkyStarsY -0x80
# walkers turning round undo their step's height too (no sticking at slope edges)
%int CK_WalkTurnUndoesY 1

%override "EPISODE.CK4"

