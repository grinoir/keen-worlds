# Revival of Bliss, as Keen (Aurora Bliss III: Dave216, 2024, v1.1) as a Keen Worlds world.
# Written by kwtools/kw_revival.py from the mod's CKPatch file; the data
# files beside it are the player's copy of the mod. It runs on Keen 4.

%string ca_tileInfo "KEEN4.TLI"

%stringarray ck_str_levelNames
	"West Bliss",
	"Bliss Precipice",
	"Shadowy Copse",
	"Ruria Peak",
	"Mirage Hillock",
	"Mt.Rosa",
	"Temple Harepan",
	"Marshlands",
	"Void Pith",
	"Musical Grove",
	"Ancient Crypt",
	"Old Shanty Town",
	"Babel's Pond",
	"Vale Sola",
	"VR-C0mPL3X 651",
	"Frigid Cave",
	"Grand Spire",
	"Temple of Orb",
	"Bean-with-Bacon\nMegarocket"

%stringarray ck_str_levelEntryText
	"Keen explores\nWest Bliss",
	"Keen clambers the\nBliss Precipice",
	"Keen enters\nthe Shadowy Copse",
	"Keen walks across\nthe Ruria Peak",
	"Keen is fooled\nby the Mirage Hillock",
	"Keen climbs the\nGreat Mt.Rosa",
	"Keen enters the\nHarepan",
	"Keen sets\nfoot in Marshlands",
	"Keen is afraid\nof the Marrow of Void",
	"Keen visits\nthe Musical Grove",
	"Keen enters\nthe Ancient Crypt",
	"Keen steps in\nOld Shanty Town",
	"Keen waddles in\ndepths of Babel's Pond",
	"Keen steps in\nmysterious Vale Sola",
	"Keen invades the\nthe VR-C0mPL3X 651",
	"Keen investigates the\nFrigid Cave",
	"Craig and Keen battle\nfor Aurora",
	"Keen falls in\nthe Temple of Orb",
	"Keen returns back to  \nBean-with-Bacon\n     Megarocket         "

%intarray CK_LevelMusic 8, 23, 12, 13, 15, 16, 18, 2, 20, 21, 22, 19, 24, 9, 10, 0, 4, 3, 11, 1

%string ck4_str_cantSwim "No ID Chip!  "
%string ck4_str_councilThanks "Human boy! This bot is\nnot the right one\nI'll have to keep\nlooking for an\nofficer-bot"
%string ck4_str_councilThanks2 "YES! This is the right\none! Let me just \nmount it on your \nhelmet. There!\nYou're now disguised! Go!"
%string ck4_str_gotWetsuit "This message should \nnever show up.. "
%string ck4_str_janitor1 " This orb is showing me\ntwo guys sitting on a\na tree. Word REUNION    \nreverberates."
%string ck4_str_janitor2 "There is this hint \nof sadness in this   \nprojection. I wonder..."
%string ck4_str_janitor3 "REUNIONnnn.... \nREUNION   "
%string ck4_str_janitor4 " I should remember\nthis...      "
%string ck4_str_lindsayMessage1 "Follow the path and \nand future will   \npresent itself. It is\nhidden. \n"
%string ck4_str_lindsayMessage2 "Is our Senpai back on \nAurora Bliss? Master \nCraig is the best!  \nRight?\n"
%string ck4_str_lindsaySays "Charmita, Capetano!  \n"
%string ck4_str_lindsayThanks1 "That journal will aid."
%string ck4_str_lindsayThanks2 "Are we talking\nabout the same  \nCraig?   \n"
%string ck4_str_statusRescued "MYAH   "
%string ck4_str_statusWetsuit "ID CHIP"
%string ck_str_exitToMap "Exit to Aurora"
%string ck_str_statusCentilives "ORBS "
%string ck_str_storyText "It seems that the\ntroubles of our heroes,\nCraig and Keen, are not\nover. The horrific\ndictator of Azura\nAstrid, Allain, has\nbeen spotted on Aurora\nBliss, plaguing the\nplanet with his\nindustrial empire. The\nheartless Al has\nshifted his focus from\nrobotics to making an\nentire planet run on\nhis perpetuum mobile\nmachine, which is\nlocated on Aurora\nBliss. The boys decide\nto put a stop to his\nevil plans and save the\nplanet Aurora from\ncertain doom. Myah\njoins them on their\nquest to avenge her\nfamily........."
%stringarray ck4_str_councilMessage
	"This is one of those \ndays...   ",
	"Just my luck. Darn.\nBye, Myah.  ",
	"Just lovely.",
	"I wonder where Craig \nhas gone to. Hmm...\nFine. I'll see you...",
	"Are you serious?  ",
	"I wonder if Krile\nstill have those  \nKabobs... ",
	"I really hope we're \ngetting closer...",
	"Well, I'll be...  \nGreat, now I hope \nthis works out.\nWish me luck!  "
%stringarray ck_defaultHighScoreNames
	"Levelass         ",
	"Nwe74            ",
	"Dave216          ",
	"K1n9_Duk3        ",
	"Myah             ",
	"Craig Canmore    ",
	"Allain           ",
	"Oracle Janitor   "

# The mod's changes to the program's rules, as settings
# its own sound and music: 25 songs from chunk 137
%string ca_audioHead "AUDIOHED.CK4"
%string ca_audioDict "AUDIODCT.CK4"
%int ca_audStartMusic 137
%int ca_audNumSongs 25
# the Ancients talk over level 0's song
%int CK4_CouncilTalkMusicLevel 0
# K1n9_Duk3's fix: the floor check ends at the map's top
%int CK_ClipToEndsSigned 1
# the Janitor talks over song 19
%int CK4_JanitorTalkMusicLevel 19
# the ending plays song 19
%int CK_EndingMusicLevel 19
# no underwater level (its death check is for a level 22 there is none of)
%int CK4_UnderwaterDeathLevel 22
# the Well of Wishes exits and scrolls normally
%int CK4_UnderwaterCameraLevel 99
# levels 17 and up are its ship levels
%int ck_maxDoneLevel 16
# Lindsey's Miragia hint is in level 17
%int CK4_LindseyMessage1Level 17
# Keen moons as often as he likes (its mooning: actions)
%int CK4_MoonAgain 1
# right-hand conveyor belts no longer carry Keen
%int CK_ConveyorRightSpeed 0
# the cloud's lightning starts at the cloud
%int CK4_CloudBoltXOffset 0
%int CK4_CloudBoltYOffset 0
# the cloud stands still while it waits to strike
%int CK4_CloudStrikeXAccel 0
# the Janitor: in level 17, four windows (the orb, Craig, Keen's answer, Craig)
%int CK4_JanitorLevel 17
%int CK4_JanitorWindows 4
%int CK4_JanitorPic 77
%int CK4_JanitorPic2 111
%int CK4_JanitorKeenPic 113
# the Ancients stand still
%int CK4_CouncilNeverPauses 1
# the Sprite's shot starts on its second frame (the first is its stunned picture)
%int CK4_SpriteShotSkipFirst 1
# Sprites float slower and less far up
%int CK4_SpritePatrolYAccel 4
%int CK4_SpritePatrolYRadiusTop 0x10
# a Sprite shoots with the sound of Keen's stunner
%int CK4_SpriteShootSound 0x2A
# Mimrocks follow Keen whichever way he faces
%int CK4_MimrockIgnoresFacing 1
# once walking a Mimrock never sits down again
%int CK4_MimrockAlwaysChases 1
# the Mimrock's jump
%int CK4_MimrockJumpYVelocity -0x27
%int CK4_MimrockJumpXVelocity 8
%int CK4_MimrockJumpXRadius 0x200
# Skypests bounce off the ground instead of landing
%int CK4_SkypestBounces 1
# the last Ancient gives the wetsuit (the ID chip; Craig: his pogo stick), with its own words
%int CK4_LastCouncilGivesWetsuit 1
# the Mad Mushroom always makes its big jump
%int CK4_MushroomNumJumps 1
# Keen is drawn behind the Mad Mushroom
%int CK4_MushroomZLayer 3
# the blue bird never flies
%int CK4_BirdNeverFlies 1
# a shot just pops on the hatched bird
%int CK4_BirdShotProof 1
# shots fly through the Madness's egg; it hatches with a sound
%int CK4_EggIgnoresShots 1
%int CK4_EggHatchSound 0x24
# Keen is drawn in front of the Treasure Eater
%int CK4_SmirkyZLayer 0
# the Treasure Eater is ridden like a bounder
%int CK4_SmirkyType 15
# a shot only makes a bounder hop
%int CK4_BounderUnstunnable 1
# bounders make no sound
%int CK4_BounderQuiet 1
# bounders slide (a hop of 1)
%int CK4_BounderBounceYVelocity -1
# bounders go where Keen is
%int CK4_BounderFollowsKeen 1
# where a stunned Devil Foot's stars are
%int CK4_InchwormStarsX 0x40
%int CK4_InchwormStarsY -0x80
# Muha (the schoolfish) clips normally
%int CK4_SchoolfishClip 1
# Allain, the boss: health by difficulty
%int CK4_DopefishIsBoss 1
# the score box shows his health in level 16
%int CK4_BossBarLevel 16
# no stars over the beaten boss
%int CK4_DopefishStarsOff 1
# beating him wins the game; rescued Ancients only end their level
%int CK4_CouncilNeverWins 1
# how long an Arachnut stays stunned, by difficulty
%int CK4_ArachnutStunTimed 1
%intarray CK4_ArachnutStunTimes 0x75, 0x28, 0x14
# Keen is drawn behind the Wormmouth
%int CK4_WormmouthZLayer 3
# the Berkeloid floats no more (its own float is its walking animation)
%int CK4_BerkeloidNoHover 1
# it doesn't turn at ledges
%int CK4_BerkeloidNoEdgeTurn 1
# the Dopefish's normal and hard markers are Muha's
%int CK4_DopefishIconsSpawnSchoolfish 1
# bounders (and what rides like them) don't push Keen off poles
%int CK4_BounderNoPolePush 1
# the blue bird's markers are Devil Feet
%int CK4_BirdIconsSpawnInchworm 1
# the story scrolls to song 16
%int CK_StarWarsMusicLevel 16
# Allain's health on easy, normal, hard ($3DBF)
%intarray CK4_DopefishHealth 0x19, 0x1E, 0x28
# the foot's flight
%int CK4_FootThereX 0x0200
%int CK4_FootThereY 0x3700
%int CK4_FootBackX 0x7200
%int CK4_FootBackY 0x3100
# bounders slide at 16
%int CK4_BounderBounceXVel 16
%int CK4_BounderRideXVel 16
# the story's colours ($2F05E)
%intarray ck_starWarsPalette 0x00, 0x01, 0x11, 0x1F, 0x04, 0x0D, 0x06, 0x07, 0x1F, 0x1F, 0x1F, 0x1F, 0x11, 0x1F, 0x1F, 0x1F, 0x00

%override "EPISODE.CK4"

