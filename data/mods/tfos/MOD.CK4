# The Terror from Outer Space (Dr. Colossus, 2013, v1.0) as a Keen Worlds world.
# Written by kwtools/kw_tfos.py from the mod's CKPatch file; the data
# files beside it are the player's copy of the mod. It runs on Keen 4.

%string ca_tileInfo "KEEN4.TLI"

%stringarray ck_str_levelNames
	"Phaelox",
	"Engine Room",
	"Chemistry Lab",
	"Reactor Core",
	"Trogg Pod",
	"Weaponry B",
	"Cratom Refinery",
	"Swamp",
	"Three Towers",
	"Mountain",
	"Hidden Bunker",
	"Volcano",
	"Trogg Village",
	"The Hills",
	"Secret Cloning Lab",
	"Radar Station",
	"Explorer",
	"Space Station",
	"Megarocket",
	"",
	"",
	""

%stringarray ck_str_levelEntryText
	"Keen explores\nPhaelox",
	"Keen bursts into\nthe Engine Room",
	"Keen enters the\nChemistry Lab",
	"Keen melts down in\nthe Reactor Core",
	"Keen drops into\nthe Trogg Pod",
	"Keen shoots his way\nthrough the Weaponry",
	"Keen rolls through\nthe Cratom Refinery",
	"Keen trudges through\nthe Swamp",
	"Keen visits the\nThree Towers",
	"Keen crawls into\nthe Mountain",
	"Keen seeks the\nHidden Bunker",
	"Keen burns at the\nVolcano",
	"Keen visits the\nTrogg Village",
	"Keen runs to\nThe Hills",
	"Keen investigates the\nSecret Cloning Lab",
	"Keen scans the\nRadar Station",
	"Keen scouts out the\nExplorer",
	"Keen Keen floats to the\nSpace Station",
	"Keen launches into the\nBean-with-Bacon\nMegarocket",
	"",
	"",
	""

%intarray CK_LevelMusic 0, 2, 3, 4, 1, 3, 3, 2, 3, 2, 1, 4, 2, 1, 3, 3, 2, 4, 4, -1, 2, 4

%string ck4_str_cantSwim "I can't go!"
%string ck4_str_councilThanks "Emergency shutdown\ninitiated.\n... \n... \nGenerator deactivated."
%string ck4_str_councilThanks2 "Emergency shutdown\ninitiated.\n... \nOrbital Generator\ndeactivated."
%string ck4_str_gotWetsuit "Cool!  I can breathe\nin space now!"
%string ck4_str_lindsayMessage1 "There's a vorticon\ncar hidden in the\nmountain.\n"
%string ck4_str_lindsayMessage2 "There's a\nSpace Suit\nhidden in the\nWeaponry!\n"
%string ck4_str_lindsaySays "Vorticon Grunt says:\n"
%string ck4_str_lindsayThanks1 "Thanks!"
%string ck4_str_lindsayThanks2 "Thanks for the\nclue!\n"
%string ck4_str_statusRescued "DISABLED"
%string ck4_str_statusWetsuit ""
%string ck_str_exitToMap "Exit to Phaelox"
%string ck_str_statusCentilives "CRATOM"
%string ck_str_statusLevel ""
%string ck_str_storyText "Commander Keen\n\nThe Terror\nFrom Outer Space\n\nThe asteroids that\nsurround the planet\nPhaelox are known for\ntheir richness in rare\nCratom crystals.\n\nThis source was\nfirst discovered\nby the Vorticons\nwho soon began\nmining them.\n\nSeveral decades ago,\nwith the Cratom source\nnearly depleted,\nthe Vorticons powered\ndown their equipment\nand left.\n\nBut now, years later,\nthe outpost has once\nagain begun operation.\n\nThe reasons for this\nare as yet\nunknown.\n"
%stringarray ck4_str_councilMessage
	"The way to the\nasteroid is free!",
	"Woo-hoo!\nAnother one!",
	"No problemo.",
	"Now to look for the\nnext Generator!\n ",
	"Yeah!",
	"Finally!\nThis is the last\none!",
	"This is the last\none!       ",
	"Your the last one,\nfella.  Let's both\nget back to the\nOracle chamber!"
%stringarray ck_defaultHighScoreNames
	"Id Software - '91",
	"",
	"Jason Blochowiak",
	"Adrian Carmack",
	"John Carmack",
	"Tom Hall",
	"John Romero",
	""

# The mod's changes to the program's rules, as settings
# read the mod's own audio header and dictionary
%string ca_audioHead "AUDIOHED.CK4"
%string ca_audioDict "AUDIODCT.CK4"
# Mushrooms jump less high
%int CK4_MushroomJumpYVel -80
# Mushrooms hop less high
%int CK4_MushroomHopYVel -21
# Wormmouths reach further right to bite
%int CK4_WormmouthBiteRightMaxX 0x580
# Wormmouths reach further left to bite
%int CK4_WormmouthBiteLeftMinX -1280
# the storm cloud drifts faster
%int CK4_CloudXAccel 0xf
# the Berkeloid's fireball starts higher
%int CK4_BerkeloidFireballYOffset -1
# the Berkeloid's fireball rises faster
%int CK4_BerkeloidFireballYVelocity -28
# the Berkeloid's fireball starts further right
%int CK4_BerkeloidFireballXOffsetRight 0x100
# the inchworm's foot sits lower
%int CK4_InchwormFootYOffset 0xf00
# Bounders bounce less high
%int CK4_BounderBounceYVelocity -70
# Princess Lindsey doesn't drift up and down
%int CK4_LindseyFloatYAccel 0
# Princess Lindsey floats in a tight band
%int CK4_LindseyFloatYRadius 1
# schoolfish swim slower sideways
%int CK4_SchoolfishXVelocity 4
# schoolfish swim slower up and down
%int CK4_SchoolfishYVelocity 4
# the storm cloud's bolt drops straight down
%int CK4_CloudBoltXOffset 0
# the storm cloud's bolt starts higher
%int CK4_CloudBoltYOffset -1280
# Licks leap higher on a long hop
%int CK4_LickLongHopYVelocity -48
# a shot only makes a Bounder hop, it can't be stunned (CK4_BounderCheckShot rewrite)
%int CK4_BounderUnstunnable 1
# Smirkies never teleport (CK4_SmirkyCol / CK4_SmirkyTeleport rewrites)
%int CK4_SmirkyNoTeleport 1
# Mimrocks follow Keen whichever way he faces (CK4_MimrockWait facing checks removed)
%int CK4_MimrockIgnoresFacing 1
# Mimrocks never sit back down once chasing (CK4_MimrockCheckJump rewrite)
%int CK4_MimrockAlwaysChases 1
# map markers 36-38 spawn flying birds by difficulty
%int OC_FlyingBirdMarkers 1
# flying birds never land
%int CK4_BirdNeverLands 1
# the walking bird stands on the ground
%int CK4_BirdSpawnYOffset 0xE1
# six of the Council win the game
%int CK4_NumCouncilsToRescue 6
# levels 21 and up are its ship levels
%int ck_maxDoneLevel 20
# its map has level doors up to level 21
%int ck_maxEnterLevel 21
# the swimming Keen clips normally
%int CK4_SwimKeenClipNormal 1
# play music on its extra levels too
%int CK_NumMusicLevels 22

%override "EPISODE.CK4"

