# Settings that name Keen 5's own (so after its file)
# Amptons: harmless, pushing, Keen's shots bounce off; an enemy shot stuns one and it drops a keycard (CR_AmptonCol)
%int CK5_AmptonExtraLump @LUMP_KEYCARD
# a mine's second piece is a Shockshund
%action CK5_ACT_MineShrapB = CK5_ACT_ShocksundJump0
# a mine needs the Shockshund's sprites
%int CK5_MineExtraLump @LUMP_SHOCKSHUND
# a stunned Shockshund jumps
%action CK5_ACT_ShocksundStunned = CK5_ACT_ShocksundJump0
# Korath: seven shots, starts walking right, a Shikadi to the program, deadly (CR_KorathWalkCol, CR_KorathCol), shoots like a turret when it stops
%int CK5_KorathHealth 7
%int CK5_KorathStartsRight 1
%int CK5_KorathType 20
%int CK5_KorathExtraLump @LUMP_LASER
# the Master needs the Shikadi's sprites
%int CK5_MasterExtraLump @LUMP_SHIKADI
# the Shikadi's sprites begin at the Master's ball ($31A30)
%intarray lumpStarts
	@PIC_HELPMENU,
	@PIC_MENUCARD,
	@PIC_CREDIT1,
	@PIC_KEENTALK1,
	@PIC_COUNTDOWN5,
	@SPR_PADDLE,
	@SPR_KEENSTANDR,
	@SPR_SECURITYCARD_1,
	@SPR_100_PTS1,
	@SPR_200_PTS1,
	@SPR_500_PTS1,
	@SPR_1000_PTS1,
	@SPR_2000_PTS1,
	@SPR_5000_PTS1,
	@SPR_1UP1,
	@SPR_GEM_A1,
	@SPR_STUNNER1,
	@SPR_LASER1,
	@SPR_MAPKEEN_WALK1_W,
	@SPR_FUSEFLASH1,
	@SPR_STAREXPLODE1,
	@SPR_TELEPORTSPARK1,
	@SPR_KORATHWALKL1,
	@SPR_MASTER1,
	312,
	@SPR_PETSIT1,
	@SPR_SPHEREFUL1,
	@SPR_SPARKYL1,
	@SPR_SHIKADIMINE,
	@SPR_SLICESTAR,
	@SPR_ROBOREDR,
	@SPR_SPIROGRABD,
	@SPR_AMPTONWALKR1,
	@SPR_VOLTEFACE1,
	@SPR_PURPLEPLAT1,
	@SPR_SPINDRED1,
	@SPR_SHELLEYR1,
	@SPR_PLATFORM
