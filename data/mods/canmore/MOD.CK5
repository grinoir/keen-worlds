# Canmore's Redemption (Aurora Bliss II: Dave216, 2023, v1.0.2) as a Keen Worlds world.
# Written by kwtools/kw_canmore.py from the mod's CKPatch file; the data
# files beside it are the player's copy of the mod. It runs on Keen 5.

%string ca_tileInfo "KEEN5.TLI"

%stringarray ck_str_levelNames
	"Azura Astrid",
	"Transport Center A",
	"City of Neon",
	"Angelic",
	"Skidrow District",
	"The Resistance ",
	"Toombree Ruins",
	"Crashed BwB Site",
	"Motherboard Tunnels",
	"Tears Cave",
	"The Grid",
	"X-42 Radio Access Tower",
	"Heart of the Complex",
	"Limpid Alley",
	"GP Head Office",
	"Highscores "

%stringarray ck_str_levelEntryText
	"Craig is thinking\nabout cool motorcycles.",
	"Craig enters the\nTransport Center A",
	"Craig is dazed by\nCity of Neon",
	"Craig falls into\nAngelic",
	"Craig wonders\ninto Skidrow Street",
	"Craig comes across\nGuerilla Resistance",
	"Craig unearths the\nToombree Ruins",
	"Craig returns to\nCrashed BwB Site",
	"Craig enters\nthe Motherboard",
	"Craig digs into\nTears Cave",
	"Craig falls into\nThe Grid",
	"Craig ascends the\nX-42 Radio Access Tower",
	"Craig is\nfighting to save Keen.",
	"Craig enters\nLimpid Alley",
	"Craig steps in\nGP Head Office",
	"Dirty little\nuses warp to enter\nHighscores"

%intarray CK_LevelMusic 3, 7, 5, 4, 9, 10, 11, 13, 18, 1, 17, 12, 16, 2, 0, 15, 6, 1, 0, 8

%string ck5_str_korath3 "Craig explores\nthe Hidden Island"
%string ck_str_exitToMap "Chicken Out"
%string ck_str_paddleWarComp "COMP "
%string ck_str_paddleWarKeen "YOU  "
%string ck_str_statusCentilives "SHADEES"
%string ck_str_statusLives "LIVES"
%string ck_str_storyText ".....Previously........\nCraig Canmore was\nforced by unknown\nfigure from outer space\nto abduct two of his\nclassmates. Billy Blaze\nand Mortimer McMire.\nThe instructions he\nreceived were simple.\nObserve your targets,\nreport your findings\nand when time comes,\nbring them to the\nplanet of Azura Astrid.\nThe voice said that he\ntook his sister\nAndrianne away and that\nif he doesn't comply,\nhe won't ever see her\nagain. Craig quickly\nlearns that his\nclassmates are space\ntravelers. He befriends\nKeen and observes how\nhe navigates BwB\nMegarocket so he can\nfly it to Azura. With\nKeen and Mort as his\ncaptives..... \n"
%stringarray ck_defaultHighScoreNames
	"Craig Canmore    ",
	"John Carmack     ",
	"Levelass         ",
	"Adrian Carmack   ",
	"Baldrick         ",
	"Tom Hall         ",
	"John Romero      ",
	"Dave216          "

# The mod's changes to the program's rules, as settings
# its own sound and music: 20 songs from chunk 186
%string ca_audioHead "AUDIOHED.CK5"
%string ca_audioDict "AUDIODCT.CK5"
%int ca_audStartMusic 186
%int ca_audNumSongs 20
# music of the ending, the story, the help and the game over
%int CK_EndingMusicLevel 15
%int CK_StarWarsMusicLevel 9
%int CK_HelpMusicLevel 2
%int CK_GameOverMusicLevel 15
# no "Keen steps out onto Korath III" on the map
%int CK5_MapMarsMinY 200
# no elevators on the map
%int ck5_mapElevators 0
# finished levels leave the map's other markers alone
%int CK_MapPreserveCoordinates 1
# no higher jump on Easy
%int ck_easyJumpGravity 0
# black help pages (the text keeps its colours for red)
%int CK_HelpBarColour 0
# dying in level 12 wins the game (its last level)
%int CK_DiedWinsLevel 12
# the secret ending: level 5 done (Myah's body armour)
%int CK5_SecretFuseLevel 5
%int CK5_SecretEndingAnyExit 1
# every fuse marker is an unseen QED: touching it, a friend speaks (CR_QEDCol)
%int CK5_QEDEveryLevel 1
# the pogo stick doesn't break fuses
%int CK5_PogoBreaksFuse 0
# slicestars take two shots
%int CK5_SliceHealth 2
%int CK5_SliceDiagHealth 2
# Shelleys don't jump off ledges
%int CK5_ShelleyNoDive 1
# Robo Red: 30 shots, from lower down, straight ahead
%int CK5_RoboNumShots 30
%int CK5_RoboShotYOffset 0x295
%int CK5_RoboShotRightXOffset 0x200
%int CK5_RoboShotYVelocity 0
# Sparkies take three shots (CR_SparkyCol)
%int CK5_SparkyHealth 3
# Spherefuls have no diamonds
%int CK5_SpherefulDiamonds 0
# Spherefuls bounce silently on ceilings and floors
%int CK5_SpherefulCeilingSound 0
%int CK5_SpherefulFloorSound -1
# the mine's eye
%int CK5_MineEyeChunk -1
# mines don't move
%int CK5_MineStill 1
# Mortimer (the Shockshund): 30 hits, then stunned by every shot; no flashing, barks less, harmless to touch
%int CK5_ShocksundHealth 30
%int CK5_ShocksundStunsAgain 1
%int CK5_ShocksundNoFlash 1
%int CK5_ShocksundShootChance 0x60
%int CK5_ShocksundHarmless 1
# Shikadi zap without a pole
%int CK5_ShikadiZapsAnywhere 1
# Shikadi don't flash when shot (four shots, as before)
%int CK5_ShikadiNoFlash 1
# the Shikadi throws the Master's ball, from lower down
%int CK5_MasterShotYOffset 0x120
# the Master's sparks fly sideways at Keen
%int CK5_PoleZapHorizontal 1
# game over: the galaxy fades to and from white and doesn't explode
%int CK5_GameOverWhite 1
# K1n9_Duk3's fix: the floor check ends at the map's top
%int CK_ClipToEndsSigned 1
# K1n9_Duk3's fix: pushing sideways leaves no height over
%int CK_PushXResetsY 1
# the friends' messages (KW9_FriendMessage)
%string kw9_str_lindsey "Myah says: Human boy,\n\ntake this body armor.\nAl's lasers won't be\nable to pierce it!"
%string kw9_str_barker "What is this?\n\nI wonder what\nwhat does this mean?"
%string kw9_str_spot "Hmmm......\n\nIt seems like a\npiece of note.\nI'll take it."
%string kw9_str_janitor "We broke free but...\n\nMort passed out.\nListen, find us a way\nout of here!"

