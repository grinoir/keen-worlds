%stringarray ck_str_levelEntryText
	"Rick traverses \nA-Danac 2 and 3",
	"Rick sneaks out of \nCell Block Alpha   ",
	"Rick skulks around \nCell Block Beta    ",
	"Rick climbs into   \nVertical Village   ",
	"Rick wades across  \nRusty's Swamp      ",
	"Rick encounters an \nAbandoned Rail Yard",
	"Rick seeks treasure\nat the Impound Lot ",
	"Rick digs\nThe Greenhouse",
	"Rick chills out in \nWest Tundra Town   ",
	"Rick takes the air \nin East Tundra Town",
	"Rick boards the    \nA-Danac Express    ",
	"Keen rockets into the\nBloog Aeronautics and\nSpace Administration",
	"Rick crashes through\nCheckpoint Zero     ",
	"Rick causes disorder\nin the Courthouse   ",
	"Rick demands answers\nin the Courthouse   \n                    ",
	"Rick bundles up and\nVentures into\nPlanet Toronto",
	"Rick encounters a\nCliff Of Some Sort",
	"Rick meets keen at\nthe Rendezvous Point",
	"Keen is in the High\nScore screen. Call Id!"

%intarray CK_LevelMusic 0, 1, 1, 4, 4, 3, 2, 5, 5, 5, 3, 6, 2, 7, 7, 6, 8, 8, -1, 0

%string ck6_str_cliffNoRope "Scram! This area is\nfor uniformed\npersonnel only!    "
%string ck6_str_getPasscard "The radio says every\ncop in the solar\nsystem's looking for\nus!...Also there's a\n force field.)"
%string ck6_str_getRope "A Snai-Danac\nuniform! And\nit's my size, too."
%string ck6_str_getSandwich "I'm sure Blaze\nwon't mind if I\nborrow this..."
%string ck6_str_grabbiterFed "The Chief Magistrate\nis probably around\nhere somewhere.\nLet's each check one\nof these buildings."
%string ck_str_exitToMap "Exit to A-Danac"
%string ck_str_itemCheat "Cheat Option!\n\nYou just got all\nthe keys, 99 shots,\nand an extra Rick!"
%string ck_str_statusCentilives "COINS"
%string ck_str_statusLives "RICKS"
%stringarray ck_defaultHighScoreNames
	"Id Software - '91",
	"",
	"Jason Blochowiak",
	"Adrian Carmack",
	"John Carmack",
	"Tom Hall",
	"John Romero",
	""

# The mod's changes to the program's rules, as settings
%string ca_audioHead "AUDIOHED.CK6"
# the Chronicle scroll (the game's HELPTEXT story, cut to a scroll)
%string ck_str_storyText "Above Meurglys III,\nbounty hunter Commander\nKeen and his former\nquarry, Rick Uller,\nshake hands: together\nthey will stop Mortimer\nMcMire once and for\nall. But the Union man\nwho comes to arrest\nthem is Mort himself,\nin disguise. He gloats\nof his latest machine,\nthe Re-Synapsizer,\nwhich will triple every\ncreature's wits and\nkill most of them, then\ndrops the pair down a\ncriminal deposit slot\nonto the Twin Prison\nPlanets, A-Danac 2 and\n3. Stripped of their\nships and Keen's pogo,\nlocked in adjoining\ncells, they have one\nhope: break out, reach\nthe Chief Magistrate,\nand play Rick's secret\nrecording of Mort's\nconfession. Now are you\nglad we teamed up?"
# Bobbas (here, caged aliens) do not shoot
%int CK6_BobbaNoShoot 1
# Babobbas (big caged aliens) do not nap or shoot
%int CK6_BabobbaNapChance 0
%int CK6_BabobbaHopsPerShot 0
# go-platforms have no accessory animation
%int CK6_GoPlatNoAccessory 1
# the hero has no pogo until it is found (the "Hello, old friend!" pickup)
%int CK_PogoNeedsWetsuit 1
# the rocket (A-Danac Express) flies without the passcard
%int CK6_RocketNoPasscard 1
# the rendezvous banter (Keen 6's Grabbiter and cliff messages, rewritten)
%string ck6_str_grabbiterHungry "Nice of you to stop\nby! Anyway, I think\nwe'll cover more\nground if we\nsplit up."
%string ck6_str_grabbiterFed "The Chief Magistrate\nis probably around\nhere somewhere.\nLet's each check one\nof these buildings."
%string ck6_str_cliffNoRope "Scram! This area is\nfor uniformed\npersonnel only!    "

%override "EPISODE.CK6"

