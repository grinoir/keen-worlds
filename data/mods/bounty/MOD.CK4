# The mod's changes to the program's rules, as settings
# levels 16 and 17 can be entered again
%int ck_maxDoneLevel 15
# the water level is 13
%int CK4_UnderwaterCameraLevel 13
%int CK4_UnderwaterDeathLevel 13
# the moon tile ends the level
%int CK4_MoonTileEndsLevel 1
# platforms without flames
%int CK4_PlatformNoFlames 1
# the Arachnut does not kill
%int CK4_ArachnutHarmless 1
# the Dopefish does not eat Keen
%int CK4_DopefishIgnoresKeen 1
# Keen always swims on the map
%int CK4_MapAlwaysSwim 1
# no wetsuit in the status window
%int CK4_StatusNoWetsuit 1
# no Council in the status window
%int CK4_StatusNoCouncil 1
# what is found in place of the wetsuit wins the game
%int CK4_WetsuitWinsGame 1
# where the foot flies
%int CK4_FootThresholdX 0x3000
%int CK4_FootThereX 0x2900
%int CK4_FootThereY 0x2600
%int CK4_FootBackX 0x3100
%int CK4_FootBackY 0x4300
# where the mirage's tiles are in the map
%int CK4_MiragiaSourceY 80
# the witch doctor does not stop to think
%int CK4_CouncilNeverPauses 1
# the item cheat gives no keys
%int CK_ItemCheatNoKeys 1
# its own sound and music headers
%string ca_audioHead "AUDIOHED.CK4"
%string ca_audioDict "AUDIODCT.CK4"

%override "EPISODE.CK4"
